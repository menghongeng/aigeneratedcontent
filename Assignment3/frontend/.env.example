# Copy this file to ".env" to change settings. Without a .env file, the app uses the fake (mock) back end.

# true  = use the built-in fake answers (no back end needed)
# false = send the text to the real back end
REACT_APP_USE_MOCK=true

# Address of the real back end (only used when REACT_APP_USE_MOCK=false)
REACT_APP_API_URL=http://localhost:5000
